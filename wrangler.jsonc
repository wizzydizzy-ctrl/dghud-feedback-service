{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dghud-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "secrets": {"required": ["GITHUB_TOKEN"]},
  "vars": {
    "GITHUB_OWNER": "wizzydizzy-ctrl",
    "PLAYER_REPO": "dragons-gate-player-hud",
    "STAFF_REPO": "dragons-gate-staff-hud"
  },
  "ratelimits": [
    {"name": "SUBMISSIONS", "namespace_id": "31001", "simple": {"limit": 3, "period": 60}},
    {"name": "GLOBAL_SUBMISSIONS", "namespace_id": "31002", "simple": {"limit": 60, "period": 60}}
  ]
}
